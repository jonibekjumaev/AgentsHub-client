# Copy to .env.local and adjust. Public values only — everything here is shipped to the browser.
# Backend (AgentsHub api) listens on PORT_API=3000 by default; `next dev` then picks the next free port.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_API_GRAPHQL_URL=http://localhost:3000/graphql
NEXT_PUBLIC_API_WS=ws://localhost:3000
